# ==============================================================================
# FIREGUARD 360 — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application
APP_NAME="FireGuard 360"
APP_ENV="development" # development | production | testing
DEBUG=true
PORT=8000
HOST="0.0.0.0"
DEMO_MODE=true

# Security (Change in production!)
SECRET_KEY="fireguard-dev-insecure-secret-key-change-in-production-minimum-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration
# Primary: PostgreSQL
POSTGRES_USER=fireguard
POSTGRES_PASSWORD=fireguard_secret
POSTGRES_DB=fireguard360
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async Database URL (used by FastAPI backend)
# PostgreSQL default: postgresql+asyncpg://fireguard:fireguard_secret@localhost:5432/fireguard360
# SQLite local dev fallback: sqlite+aiosqlite:///./fireguard.db
DATABASE_URL="sqlite+aiosqlite:///./fireguard.db"

# Sync Database URL (used by Alembic migrations when running sync mode)
# PostgreSQL default: postgresql+psycopg2://fireguard:fireguard_secret@localhost:5432/fireguard360
# SQLite local dev fallback: sqlite:///./fireguard.db
SYNC_DATABASE_URL="sqlite:///./fireguard.db"

# CORS Origins (Comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

